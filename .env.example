# Copie este arquivo para ".env" e preencha com os dados do seu Supabase
# (Supabase > Project Settings > API). O arquivo .env nunca vai para o GitHub.
# A chave "anon" é pública por natureza; quem protege os dados são as regras do banco.
# NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
